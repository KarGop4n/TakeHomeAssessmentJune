{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Slack": {
    "WebhookUrl": "https://hooks.slack.com/services/WORKSPACE_ID/CHANNEL_ID/WEBHOOK_TOKEN"
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "EnableSsl": true,
    "Username": "your-email@gmail.com",
    "Password": "your-app-password-here",
    "FromAddress": "your-email@gmail.com",
    "DefaultRecipients": [
      "recipient@example.com"
    ]
  },
  "Detection": {
    "RecentNoticeDays": 3,
    "MaxNoticeAgeForTradingDays": 3,
    "HighVolumeThresholdMmbtu": 1000,
    "MediumVolumeThresholdMmbtu": 500,
    "CriticalKeywords": [
      "force majeure",
      "emergency",
      "unplanned",
      "critical"
    ],
    "HenryHubKeywords": [
      "louisiana",
      "henry hub",
      "gulf coast",
      "la"
    ]
  },
  "Monitoring": {
    "MonitoringIntervalMinutes": 5,
    "NotificationRetentionHours": 24,
    "EnableConsoleOutput": true,
    "EnableDetailedLogging": true
  },
  "Notification": {
    "EmailFrequencyHours": 0.1,
    "SlackMinimumSeverity": "Medium",
    "EmailMinimumSeverity": "Low",
    "ImmediateEmailForCritical": true
  },
  "Pipelines": {
    "ANR": {
      "Name": "ANR Pipeline",
      "BaseUrl": "https://ebb.anrpl.com",
      "NoticesPath": "/",
      "IsEnabled": true,
      "RequestDelayMs": 2000
    },
    "TETCO": {
      "Name": "TETCO Pipeline",
      "BaseUrl": "https://infopost.enbridge.com",
      "NoticesPath": "/infopost/TEHome.asp?Pipe=TE",
      "IsEnabled": true,
      "RequestDelayMs": 15000
    },
    "GulfSouth": {
      "Name": "GulfSouth Pipeline",
      "BaseUrl": "https://infopost.bwpipelines.com",
      "NoticesPath": "/?tspid=1",
      "IsEnabled": true,
      "RequestDelayMs": 2000
    },
    "ColumbiaGulf": {
      "Name": "Columbia Gulf Pipeline",
      "BaseUrl": "https://ebb.tceconnects.com",
      "NoticesPath": "/infopost/ReportViewer.aspx?/InfoPost/Notices&assetNbr=51&rs:Format=CSV",
      "IsEnabled": true,
      "RequestDelayMs": 3000
    },
    "CreoleTrail": {
      "Name": "Creole Trail & Corpus Christi",
      "BaseUrl": "https://lngconnectionapi.cheniere.com",
      "NoticesPath": "/api/Notice/GetNoticesByPageId",
      "IsEnabled": true,
      "RequestDelayMs": 2000
    },
    "Sabine": {
      "Name": "Sabine Pipeline",
      "BaseUrl": "https://www.gasnom.com/ip/SABINE",
      "NoticesPath": "/notices.cfm",
      "IsEnabled": true,
      "RequestDelayMs": 2000
    },
    "NGPL": {
      "Name": "NGPL Pipeline",
      "BaseUrl": "https://pipeline2.kindermorgan.com",
      "NoticesPath": "/Notices/Notices.aspx",
      "IsEnabled": true,
      "RequestDelayMs": 2000
    }
  }
}